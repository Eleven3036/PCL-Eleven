                    <local:MyButton Grid.Row="9" Grid.Column="2" MinWidth="140" Text="{DynamicResource Setup.About.Licenses.ViewWebsite}" Padding="13,0" Margin="0,7,20,18" HorizontalAlignment="Left"
                                    local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://www.ookii.org/Software/Dialogs/" />
                    <local:MyButton Grid.Row="9" Grid.Column="3" MinWidth="140" Text="{DynamicResource Setup.About.Licenses.ViewLicense}" Padding="13,0" Margin="0,7,20,18" HorizontalAlignment="Left"
                                    local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://github.com/caioproiete/ookii-dialogs-wpf/blob/master/LICENSE" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Iconmonstr" TextWrapping="Wrap" FontWeight="Bold" />
                    <TextBlock Grid.Row="10" Grid.Column="2" Grid.ColumnSpan="2" Text="Copyright © 2019 iconmonstr (Alexander Kahlkopf)" TextWrapping="Wrap" />
                    <local:MyButton Grid.Row="11" Grid.Column="2" MinWidth="140" Text="{DynamicResource Setup.About.Licenses.ViewWebsite}" Padding="13,0" Margin="0,7,20,18" HorizontalAlignment="Left"
                                    local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://iconmonstr.com/" />
                    <local:MyButton Grid.Row="11" Grid.Column="3" MinWidth="140" Text="{DynamicResource Setup.About.Licenses.ViewLicense}" Padding="13,0" Margin="0,7,20,18" HorizontalAlignment="Left"
                                    local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://iconmonstr.com/license/" />

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="libwebp wrapper for .NET" TextWrapping="Wrap" FontWeight="Bold" />
