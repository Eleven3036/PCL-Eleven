                    <local:MyButton Grid.Row="13" Grid.Column="2" MinWidth="140" Text="{DynamicResource Setup.About.Licenses.ViewWebsite}" Padding="13,0" Margin="0,7,20,18" HorizontalAlignment="Left"
                                    local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://github.com/imazen/libwebp-net" />
                    <local:MyButton Grid.Row="13" Grid.Column="3" MinWidth="140" Text="{DynamicResource Setup.About.Licenses.ViewLicense}" Padding="13,0" Margin="0,7,20,18" HorizontalAlignment="Left"
                                    local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://github.com/imazen/libwebp-net/blob/master/LICENSE.txt" />

                    <TextBlock Grid.Row="14" Grid.Column="0" Text="Iconfont" TextWrapping="Wrap" FontWeight="Bold" />
                    <TextBlock Grid.Row="14" Grid.Column="2" Grid.ColumnSpan="2" Text="Copyright © ALIMAMA MUX, powered by alimama THX." TextWrapping="Wrap" />
                    <local:MyButton Grid.Row="15" Grid.Column="2" MinWidth="140" Text="{DynamicResource Setup.About.Licenses.ViewWebsite}" Padding="13,0" Margin="0,7,20,18" HorizontalAlignment="Left"
                                    local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://www.iconfont.cn/" />

                    <TextBlock Grid.Row="16" Grid.Column="0" Text="ThrottleDebounce" TextWrapping="Wrap" FontWeight="Bold" />
                    <TextBlock Grid.Row="16" Grid.Column="2" Grid.ColumnSpan="2" Text="Copyright © 2026 Ben Hutchison&#xa;Licensed under the Apache License, Version 2.0." TextWrapping="Wrap" />
                    <local:MyButton Grid.Row="17" Grid.Column="2" MinWidth="140" Text="{DynamicResource Setup.About.Licenses.ViewWebsite}" Padding="13,0" Margin="0,7,20,18" HorizontalAlignment="Left"
                                    local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://github.com/Aldaviva/ThrottleDebounce" />
                    <local:MyButton Grid.Row="17" Grid.Column="3" MinWidth="140" Text="{DynamicResource Setup.About.Licenses.ViewLicense}" Padding="13,0" Margin="0,7,20,18" HorizontalAlignment="Left"
                                    local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://licenses.nuget.org/Apache-2.0" />

                    <TextBlock Grid.Row="18" Grid.Column="0" Text="CacheCow" TextWrapping="Wrap" FontWeight="Bold" />
                    <TextBlock Grid.Row="18" Grid.Column="2" Grid.ColumnSpan="2" Text="Copyright © Ali Kheyrollahi&#xa;Licensed under the MIT License." TextWrapping="Wrap" />
                    <local:MyButton Grid.Row="19" Grid.Column="2" MinWidth="140" Text="{DynamicResource Setup.About.Licenses.ViewWebsite}" Padding="13,0" Margin="0,7,20,18" HorizontalAlignment="Left"
                                    local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://github.com/aliostad/CacheCow" />
                    <local:MyButton Grid.Row="19" Grid.Column="3" MinWidth="140" Text="{DynamicResource Setup.About.Licenses.ViewLicense}" Padding="13,0" Margin="0,7,20,18" HorizontalAlignment="Left"
                                    local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://licenses.nuget.org/MIT" />

                    <TextBlock Grid.Row="20" Grid.Column="0" Text="Transformer Discovery Service" TextWrapping="Wrap" FontWeight="Bold" />
                    <TextBlock Grid.Row="20" Grid.Column="2" Grid.ColumnSpan="2" Text="Copyright © 2020 huangyuhui &lt;huanghongxun2008@126.com&gt; and contributors&#xa;Licensed under the GNU General Public License, Version 3 or later, with additional terms.&#xa;本组件作为独立组件分发，可依 GPL 复制、修改及再分发。" TextWrapping="Wrap" />
                    <local:MyButton Grid.Row="21" Grid.Column="2" MinWidth="140" Text="{DynamicResource Setup.About.Licenses.ViewWebsite}" Padding="13,0" Margin="0,7,20,18" HorizontalAlignment="Left"
                                    local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://github.com/HMCL-dev/HMCL/tree/main/minecraft/libraries/HMCLTransformerDiscoveryService" />
                    <local:MyButton Grid.Row="21" Grid.Column="3" MinWidth="140" Text="{DynamicResource Setup.About.Licenses.ViewLicense}" Padding="13,0" Margin="0,7,20,18" HorizontalAlignment="Left"
                                    local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://github.com/HMCL-dev/HMCL/blob/main/LICENSE" />
