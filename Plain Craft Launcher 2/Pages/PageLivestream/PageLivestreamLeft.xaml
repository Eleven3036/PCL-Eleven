<local:MyPageLeft x:Class="PCL.PageLivestreamLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                  mc:Ignorable="d">
    <StackPanel Orientation="Vertical" x:Name="PanItem" Margin="0,12,0,0">

        <TextBlock Text="{DynamicResource Livestream.Left.Title}" Margin="13,5,5,3" Opacity="0.6" FontSize="12" />

        <local:MyListItem x:Name="ItemAll"
                          Type="RadioBox" Tag="0" IsScaleAnimationEnabled="False"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="{DynamicResource Livestream.Left.All}" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/play-circle" />

        <local:MyListItem x:Name="ItemBili"
                          Type="RadioBox" Tag="bilibili" IsScaleAnimationEnabled="False"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="{DynamicResource Livestream.Left.Bilibili}" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/monitor-cog" />

        <local:MyListItem x:Name="ItemHuya"
                          Type="RadioBox" Tag="huya" IsScaleAnimationEnabled="False"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="{DynamicResource Livestream.Left.Huya}" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/globe" />

        <local:MyListItem x:Name="ItemDouyu"
                          Type="RadioBox" Tag="douyu" IsScaleAnimationEnabled="False"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="{DynamicResource Livestream.Left.Douyu}" Check="PageCheck"
                          LogoScale="0.9"
                          SvgIcon="lucide/layers" />

        <local:MyIconButton x:Name="BtnRefresh" Click="BtnRefresh_Click"
                            Margin="10,20,10,5" Height="32"
                            Theme="White"
                            ToolTip="{DynamicResource Livestream.Left.Refresh}"
                            SvgIcon="lucide/refresh-cw" />

    </StackPanel>
</local:MyPageLeft>
