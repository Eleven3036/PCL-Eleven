<local:MyPageRight x:Class="PCL.PageLivestreamRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                   PanScroll="{Binding ElementName=PanBack}"
                   mc:Ignorable="d">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="PanMain" Margin="25,10">

            <!-- 直播间列表层 -->
            <StackPanel x:Name="PanList">

                <local:MyCard Margin="0,15" Title="{DynamicResource Livestream.Right.Title}">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LabSummary"
                                       Foreground="{DynamicResource ColorBrushGray2}"
                                       Text="{DynamicResource Livestream.Right.Loading}" />
                            <local:MyIconButton Grid.Column="1"
                                                x:Name="BtnReload" Click="BtnReload_Click"
                                                Theme="White" Height="28" Width="28"
                                                SvgIcon="lucide/refresh-cw" />
                        </Grid>

                        <!-- 列表 -->
                        <ItemsControl x:Name="ListRooms" Grid.Row="1" Margin="0,15,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <local:MyCard Margin="0,0,12,12" Width="220" Height="200">
                                        <Grid Margin="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 封面/状态栏 -->
                                            <Border Grid.Row="0" Height="110" CornerRadius="6" ClipToBounds="True"
                                                    Background="{DynamicResource ColorBrushBackground}">
                                                <Grid>
                                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="LowQuality" />
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            Margin="6" Padding="6,2" CornerRadius="3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#CC000000" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="online">
                                                                        <Setter Property="Background" Value="#CCE53935" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                                                            <TextBlock.Text>
                                                                <Binding Path="StatusLabel" />
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- 名称 -->
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="Bold"
                                                       Foreground="{DynamicResource ColorBrush1}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="34" />

                                            <!-- 平台 + 类型 -->
                                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{DynamicResource ColorBrushBackground}"
                                                        CornerRadius="3" Padding="6,1,6,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding PlatformLabel}" FontSize="11"
                                                               Foreground="{DynamicResource ColorBrushGray2}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding GameType}" FontSize="11"
                                                           Foreground="{DynamicResource ColorBrushGray4}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- 描述 + 点击按钮 -->
                                            <Grid Grid.Row="3" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Description}" FontSize="11"
                                                           Foreground="{DynamicResource ColorBrushGray4}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <local:MyIconTextButton Grid.Column="1" Click="BtnWatch_Click"
                                                                        VerticalAlignment="Center" Height="26"
                                                                        x:Name="BtnWatchCard"
                                                                        Text="{DynamicResource Livestream.Right.Watch}"
                                                                        SvgIcon="lucide/play"
                                                                        LogoScale="0.75" />
                                            </Grid>
                                        </Grid>
                                    </local:MyCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 空列表提示 -->
                        <local:MyCard x:Name="CardEmpty" Margin="0,15,0,0"
                                      Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Margin="30,20">
                                <TextBlock Text="{DynamicResource Livestream.Right.Empty}"
                                           Foreground="{DynamicResource ColorBrushGray4}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </local:MyCard>

                        <!-- 错误提示 -->
                        <local:MyCard x:Name="CardError" Margin="0,15,0,0"
                                      Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Margin="30,20">
                                <TextBlock x:Name="LabError"
                                           Foreground="{DynamicResource ColorBrushRedLight}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </local:MyCard>

                        <!-- 加载中 -->
                        <local:MyCard x:Name="CardLoading" Margin="0,15,0,0"
                                      Visibility="Collapsed">
                            <StackPanel Margin="20,15">
                                <local:MyLoading Text="{DynamicResource Livestream.Right.Loading}" />
                            </StackPanel>
                        </local:MyCard>

                    </Grid>
                </local:MyCard>

            </StackPanel>

            <!-- 播放器层（全屏覆盖） -->
            <Grid x:Name="PanPlayer" Visibility="Collapsed" Panel.ZIndex="100">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 播放器工具栏 -->
                <Grid Grid.Row="0" Height="40" Background="#E6000000">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <local:MyIconButton Grid.Column="0" Margin="10,0,0,0"
                                        Click="BtnPlayerBack_Click"
                                        Theme="White" Height="28" Width="28"
                                        SvgIcon="lucide/arrow-left" />
                    <TextBlock Grid.Column="1" x:Name="LabPlayerTitle"
                               Foreground="White" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="15,0" />
                    <local:MyIconButton Grid.Column="2" Margin="0,0,10,0"
                                        Click="BtnPlayerOpenExternal_Click"
                                        Theme="White" Height="28" Width="28"
                                        ToolTip="{DynamicResource Livestream.Right.OpenExternal}"
                                        SvgIcon="lucide/external-link" />
                </Grid>

                <!-- WebView2 播放器 -->
                <wv2:WebView2 x:Name="WebView" Grid.Row="1" />

                <!-- 播放器加载遮罩 -->
                <Border x:Name="PanPlayerLoading" Background="#E6000000"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Grid.RowSpan="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <local:MyLoading Text="{DynamicResource Livestream.Right.LoadingPlayer}" />
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </local:MyScrollViewer>
</local:MyPageRight>
